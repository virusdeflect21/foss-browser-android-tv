# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# The Gradle wrapper and shell scripts must keep LF so they run on every platform
gradlew text eol=lf
*.sh text eol=lf

# Windows helper scripts
*.bat text eol=crlf

# Binary files must stay untouched
*.jar binary
*.jks binary
*.keystore binary
*.png binary
*.jpg binary
*.webp binary
