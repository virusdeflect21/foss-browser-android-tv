<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus ring for list rows of ListView/GridView based lists. It is drawn on top of
  the row (drawSelectorOnTop) so that it stays readable even though the rows have
  their own card background.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <stroke
        android:width="@dimen/tv_focus_stroke_width"
        android:color="@color/tv_focus_ring" />

    <corners android:radius="@dimen/tv_list_row_corner_radius" />

</shape>
