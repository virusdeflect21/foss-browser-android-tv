<?xml version="1.0" encoding="utf-8"?>
<!--
  TV remote mouse pointer: a crisp target.
  * dark outer edge -> keeps the circle readable on white pages
  * white ring      -> clearly visible on dark pages
  * primary dot     -> the exact click point (also the visual anchor at 3 m distance)
  The old soft grey halo is gone on purpose: on a TV it looked like a smudge instead of
  a pointer. The elevation on the view provides a subtle, real shadow instead.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1dp dark contrast edge -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#8C000000" />
        </shape>
    </item>

    <!-- white ring with a very light fill -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- centre dot = click point -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>

</layer-list>
