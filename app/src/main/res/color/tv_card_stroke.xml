<?xml version="1.0" encoding="utf-8"?>
<!--
  Stroke colour for cards that can hold the D-pad focus (browser bar, list rows,
  menu entries). Unfocused cards keep their usual outline, focused cards switch
  to the primary colour so that the focus position is always obvious.
  Source: https://developer.android.com/design/ui/tv/guides/styles/focus-system
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:color="?attr/colorPrimary"
        android:state_focused="true" />
    <item
        android:color="?attr/colorPrimary"
        android:state_selected="true" />

    <item android:color="?attr/colorOutlineVariant" />

</selector>
