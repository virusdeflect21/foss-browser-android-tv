<?xml version="1.0" encoding="utf-8"?>
<!--
  TV browser chrome.

  Layout rules used here:
  * 16:9 landscape, controls inside the 5% overscan safe area (48dp sides / 27dp top-bottom).
    https://developer.android.com/design/ui/tv/guides/styles/layouts
  * Every interactive element is focusable and shows a visible focus ring.
    https://developer.android.com/design/ui/tv/guides/styles/focus-system
  * Readable from 10 feet: bigger icons, larger text, taller bar.
  * Page content is deliberately full bleed (the web view is not clipped to the safe area),
    only the chrome is inset - "don't clip background screen elements to the overscan safe area".
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="ContentDescription">

    <!-- Web page host. Always full bleed. -->
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:defaultFocusHighlightEnabled="false"
        android:descendantFocusability="afterDescendants" />

    <!-- Loading indicator: top edge, full width (does not need an inset) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/main_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:trackThickness="6dp" />

    <!--
      Bottom bar: address/favicon/title, tab overview and main menu.
      One row, three focus targets - D-pad left/right moves between them.
    -->
    <LinearLayout
        android:id="@+id/appBar_buttons"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_bottom_bar_height"
        android:layout_gravity="bottom"
        android:paddingStart="@dimen/tv_safe_margin_horizontal"
        android:paddingEnd="@dimen/tv_safe_margin_horizontal"
        android:layout_marginBottom="@dimen/tv_safe_margin_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="RelativeOverlap">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/appBar"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/tv_bottom_bar_height"
            android:layout_weight="1"
            app:backgroundTint="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/tv_bottom_bar_corner_radius"
            app:strokeColor="@color/tv_card_stroke"
            app:strokeWidth="@dimen/tv_focus_stroke_width"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/item_cardView"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="20dp"
                    android:backgroundTint="@android:color/transparent"
                    app:cardCornerRadius="4dp">

                    <ImageView
                        android:id="@+id/menu_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="fitCenter"
                        tools:ignore="ContentDescription" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/textGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/appBar_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/appbar_URL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOutline"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_overview"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            app:backgroundTint="?attr/colorOutline"
            app:borderWidth="0.5dp"
            android:backgroundTint="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/icon_bookmark"
            android:foreground="@drawable/tv_focus_ring"
            app:maxImageSize="@dimen/tv_icon_size"
            app:fabCustomSize="@dimen/tv_icon_button_size"
            app:elevation="0dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_menu"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            app:backgroundTint="?attr/colorOutline"
            app:borderWidth="0.5dp"
            android:backgroundTint="#00000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/icon_profile_standard"
            android:foreground="@drawable/tv_focus_ring"
            app:maxImageSize="@dimen/tv_icon_size"
            app:fabCustomSize="@dimen/tv_icon_button_size"
            app:elevation="0dp" />

    </LinearLayout>

    <!-- In-page search ("search on this site"), sits above the bottom bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchOnSiteLayout"
        android:visibility="gone"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_bottom_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/tv_safe_margin_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_margin_horizontal"
        android:layout_marginBottom="130dp"
        app:backgroundTint="?attr/colorSurfaceContainer"
        app:cardCornerRadius="@dimen/tv_bottom_bar_corner_radius"
        app:strokeColor="@color/tv_card_stroke"
        app:strokeWidth="@dimen/tv_focus_stroke_width"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/searchOnSite_buttonClose"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_marginEnd="15dp"
                android:foreground="@drawable/tv_focus_ring"
                app:icon="@drawable/icon_close"
                app:iconSize="@dimen/tv_icon_size" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchOnSite_textField"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentBottom="true"
                android:layout_toStartOf="@+id/searchOnSite_buttonClose"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingBottom="5dp"
                android:paddingTop="5dp"
                android:hint="@string/menu_other_searchSite"
                app:boxCornerRadiusTopStart="40dp"
                app:boxCornerRadiusTopEnd="40dp"
                app:boxCornerRadiusBottomStart="40dp"
                app:boxCornerRadiusBottomEnd="40dp"
                app:boxStrokeWidth="0.5dp"
                app:boxStrokeWidthFocused="@dimen/tv_focus_stroke_width"
                app:startIconDrawable="@drawable/icon_up"
                app:endIconDrawable="@drawable/icon_down"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchOnSite_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text|textUri"
                    android:selectAllOnFocus="true"/>

            </com.google.android.material.textfield.TextInputLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!--
      Remote mouse pointer. Last child = drawn on top of everything. It is moved by the
      D-pad and OK clicks at its centre (see BrowserActivity.initTvCursor()). The view is
      never clickable / focusable itself, so real touch input and the D-pad focus
      navigation are not affected. It is clipped nowhere (clipToPadding/clipChildren of
      the root are off) so that half the circle stays visible at the screen edges.
    -->
    <View
        android:id="@+id/tv_cursor"
        android:layout_width="@dimen/tv_cursor_size"
        android:layout_height="@dimen/tv_cursor_size"
        android:background="@drawable/tv_cursor"
        android:clickable="false"
        android:elevation="8dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

</FrameLayout>
