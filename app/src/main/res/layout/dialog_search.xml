<?xml version="1.0" encoding="utf-8"?>
<!--
  Omni box / search dialog. The text field is the first focus target (TV shows the
  on-screen keyboard for it), suggestions are focusable list rows underneath.
  Focused box stroke is twice as thick so that the focus is visible from 10 feet.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListView
        android:id="@+id/list_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/search_textField"
        android:layout_marginStart="@dimen/tv_safe_margin_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_margin_horizontal"
        android:paddingTop="15dp"
        android:divider="@null"
        android:fastScrollEnabled="true"
        android:drawSelectorOnTop="true"
        android:focusable="true"
        android:listSelector="@drawable/tv_list_selector"
        android:stackFromBottom="true"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_textField"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/tv_safe_margin_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_margin_horizontal"
        android:layout_marginBottom="@dimen/tv_safe_margin_vertical"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        android:hint="@string/main_omnibox_input_hint"
        app:boxCornerRadiusTopStart="40dp"
        app:boxCornerRadiusTopEnd="40dp"
        app:boxCornerRadiusBottomStart="40dp"
        app:boxCornerRadiusBottomEnd="40dp"
        app:boxStrokeWidth="0.5dp"
        app:boxStrokeWidthFocused="@dimen/tv_focus_stroke_width"
        app:startIconDrawable="@drawable/icon_close"
        app:endIconDrawable="@drawable/icon_search"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text|textUri"
            android:selectAllOnFocus="true"/>

    </com.google.android.material.textfield.TextInputLayout>

</RelativeLayout>
