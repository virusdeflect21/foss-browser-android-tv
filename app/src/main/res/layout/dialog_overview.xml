<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab / bookmark / history overview.
  * List rows are focusable (see item_list.xml), the list itself does not draw a
    second highlight.
  * Bottom navigation is the only other focus row, so D-pad up/down switches
    between list and tabs, left/right moves inside bottom navigation.
  * Chrome stays inside the overscan safe area.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="Overdraw">

    <ListView
        android:id="@+id/list_overView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:fastScrollEnabled="true"
        android:drawSelectorOnTop="true"
        android:focusable="true"
        android:listSelector="@drawable/tv_list_selector"
        android:stackFromBottom="true"
        android:layout_above="@+id/bottom_navigation"
        android:layout_marginStart="@dimen/tv_safe_margin_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_margin_horizontal"
        android:paddingTop="10dp"/>

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_safe_margin_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_margin_horizontal"
        android:layout_above="@+id/bottom_navigation">
        <LinearLayout
            android:id="@+id/listTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:stackFromBottom="true"
            android:paddingTop="10dp"/>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/tv_safe_margin_horizontal"
        android:layout_marginStart="@dimen/tv_safe_margin_horizontal"
        android:layout_marginBottom="@dimen/tv_safe_margin_vertical"
        android:minHeight="?attr/actionBarSize"
        app:itemIconSize="@dimen/tv_icon_size"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_overview"/>

</RelativeLayout>
